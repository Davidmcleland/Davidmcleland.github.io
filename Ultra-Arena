<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ULTRA-ARENA</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        body { margin: 0; overflow: hidden; background: #050505; user-select: none; font-family: 'Courier New', monospace; }
        #canvas { display: block; width: 100vw; height: 100vh; }
        
        /* HUD Elements */
        .hud-text { text-shadow: 2px 2px 0 #000; }
        
        /* CRT Scanline Effect */
        .crt-lines {
            position: fixed; inset: 0; pointer-events: none; z-index: 90;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            background-size: 100% 4px, 4px 100%;
            opacity: 0.6;
        }

        .crosshair-center {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 4px; height: 4px; background: #0ff; border-radius: 50%; pointer-events: none; z-index: 50;
            box-shadow: 0 0 10px #0ff;
        }
        .crosshair-circle {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            width: 40px; height: 40px; border: 2px solid rgba(0, 255, 255, 0.5); border-radius: 50%; pointer-events: none; z-index: 50;
            transition: width 0.1s, height 0.1s;
            box-shadow: 0 0 10px rgba(0, 255, 255, 0.3);
        }

        #hitmarker {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(45deg);
            width: 20px; height: 20px; pointer-events: none; opacity: 0; transition: opacity 0.05s; z-index: 51;
        }
        #hitmarker::before, #hitmarker::after { content: ""; position: absolute; background: #ff0000; }
        #hitmarker::before { top: 9px; left: 0; width: 20px; height: 2px; }
        #hitmarker::after { top: 0; left: 9px; width: 2px; height: 20px; }

        #damageOverlay {
            position: absolute; inset: 0; pointer-events: none; z-index: 40;
            box-shadow: inset 0 0 0 0 rgba(255,0,0,0); transition: box-shadow 0.1s;
        }
        
        .style-rank {
            font-style: italic; font-weight: 900;
            animation: pulse 0.5s infinite alternate;
        }
        @keyframes pulse { from { transform: scale(1); } to { transform: scale(1.1); } }
    </style>
</head>
<body>
    <!-- Instructions -->
    <div id="instructions" class="absolute inset-0 flex items-center justify-center bg-black/80 z-[100] text-center text-white">
        <div class="bg-gray-900 p-8 border-2 border-red-600 shadow-[0_0_50px_rgba(220,38,38,0.5)] max-w-lg">
            <h1 class="text-6xl font-black text-red-600 mb-2 tracking-tighter italic">ULTRA-ARENA</h1>
            <p class="text-cyan-400 mb-6 font-mono tracking-widest">BLOOD IS FUEL</p>
            <div class="text-left space-y-1 text-sm font-mono text-gray-300 bg-black/50 p-4 mb-6 border border-gray-700">
                <p><span class="text-yellow-400 font-bold">WASD</span> Move <span class="text-gray-500">//</span> <span class="text-yellow-400 font-bold">SPACE</span> Jump</p>
                <p><span class="text-yellow-400 font-bold">SHIFT</span> Dash/Slide</p>
                <p><span class="text-yellow-400 font-bold">1-3</span> Switch Weapon</p>
                <p><span class="text-yellow-400 font-bold">L-CLICK</span> Fire</p>
                <p><span class="text-yellow-400 font-bold">R</span> Restart</p>
            </div>
            <p class="animate-pulse text-xl font-bold text-white">CLICK TO START</p>
        </div>
    </div>

    <!-- CRT Overlay -->
    <div class="crt-lines"></div>

    <!-- Crosshair -->
    <div class="crosshair-center"></div>
    <div id="crosshairCircle" class="crosshair-circle"></div>
    <div id="hitmarker"></div>
    <div id="damageOverlay"></div>

    <!-- HUD -->
    <div id="hud" class="hidden pointer-events-none font-mono">
        <!-- Health -->
        <div class="fixed bottom-8 left-8 flex flex-col w-64">
            <div class="flex justify-between items-baseline mb-1 text-white hud-text">
                <span class="text-3xl font-black italic">HP</span>
                <span id="hpVal" class="text-4xl font-bold text-red-500">100</span>
            </div>
            <div class="h-6 bg-black/50 border-2 border-white skew-x-[-15deg] p-1">
                <div id="hpBar" class="h-full bg-red-600 w-full transition-all duration-100"></div>
            </div>
        </div>

        <!-- Weapon Info -->
        <div class="fixed bottom-8 right-8 text-right">
            <div id="weaponName" class="text-4xl font-black italic text-cyan-400 hud-text mb-1">REVOLVER</div>
            <div class="text-2xl text-white hud-text">
                <span id="ammoVal">∞</span> <span class="text-sm text-gray-400">AMMO</span>
            </div>
            <div class="flex justify-end gap-2 mt-2">
                <div id="wep1" class="w-8 h-1 bg-cyan-400"></div>
                <div id="wep2" class="w-8 h-1 bg-gray-600"></div>
                <div id="wep3" class="w-8 h-1 bg-gray-600"></div>
            </div>
        </div>

        <!-- Score / Style -->
        <div class="fixed top-8 right-8 text-right">
            <div class="text-sm text-gray-400 tracking-widest uppercase">STYLE</div>
            <div id="scoreVal" class="text-5xl font-black italic text-yellow-400 hud-text">0</div>
            <div id="styleText" class="text-xl font-bold text-purple-400 h-6 mt-1"></div>
        </div>
        
        <!-- Wave Info -->
        <div class="fixed top-8 left-1/2 -translate-x-1/2 text-center">
            <div class="text-xs text-gray-500 uppercase tracking-[0.5em]">THREAT LEVEL</div>
            <div id="waveVal" class="text-3xl font-bold text-red-600 hud-text">I</div>
        </div>
    </div>

    <!-- Death Screen -->
    <div id="deathScreen" class="hidden fixed inset-0 bg-red-900/40 z-[200] flex items-center justify-center backdrop-blur-sm">
        <div class="text-center">
            <h1 class="text-8xl font-black text-white italic mb-4 hud-text">DEAD</h1>
            <p class="text-2xl text-yellow-400 font-mono mb-8">FINAL SCORE: <span id="finalScore">0</span></p>
            <p class="text-white text-lg">PRESS <span class="font-bold border px-2">R</span> TO RESTART</p>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Post Processing Dependencies -->
    <script src="https://unpkg.com/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
    <script src="https://unpkg.com/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
    <script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
    <script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
    <script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
    <script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>

    <script>
        // --- CONFIG & STATE ---
        const CONFIG = {
            gravity: -70,
            speed: 50,           // FASTER
            groundAccel: 180,    // SNAPPIER
            airAccel: 40,
            jumpForce: 32,       // HIGHER
            friction: 12,        // SLIPPIER
            slideFriction: 0.5,  // SUPER SLIDE
            lookSens: 0.002,
            tiltAmount: 0.05     // Camera Tilt
        };

        const state = {
            score: 0,
            wave: 1,
            active: false,
            gameOver: false,
            lastTime: 0
        };

        const keys = { w:0, a:0, s:0, d:0, space:0, shift:0, e:0 };

        // --- THREE.JS SETUP ---
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x100505); // Dark reddish bg
        scene.fog = new THREE.FogExp2(0x100505, 0.015);

        const camera = new THREE.PerspectiveCamera(90, window.innerWidth/window.innerHeight, 0.1, 300);
        const renderer = new THREE.WebGLRenderer({ antialias: false, powerPreference: "high-performance" }); 
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.shadowMap.enabled = true;
        renderer.toneMapping = THREE.ReinhardToneMapping; // Better lighting range
        document.body.appendChild(renderer.domElement);

        // --- POST PROCESSING ---
        const composer = new THREE.EffectComposer(renderer);
        const renderPass = new THREE.RenderPass(scene, camera);
        composer.addPass(renderPass);

        // Bloom (Glow)
        const bloomPass = new THREE.UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.5, 0.4, 0.85);
        bloomPass.threshold = 0.2;
        bloomPass.strength = 0.8; // Intense glow
        bloomPass.radius = 0.5;
        composer.addPass(bloomPass);

        // Chromatic Aberration (Glitch/Retro effect)
        const ChromaticAberrationShader = {
            uniforms: {
                "tDiffuse": { value: null },
                "amount": { value: 0.002 }
            },
            vertexShader: `
                varying vec2 vUv;
                void main() {
                    vUv = uv;
                    gl_Position = projectionMatrix * modelViewMatrix * vec4( position, 1.0 );
                }
            `,
            fragmentShader: `
                uniform sampler2D tDiffuse;
                uniform float amount;
                varying vec2 vUv;
                void main() {
                    float r = texture2D( tDiffuse, vUv + vec2( amount, 0.0 ) ).r;
                    float g = texture2D( tDiffuse, vUv ).g;
                    float b = texture2D( tDiffuse, vUv - vec2( amount, 0.0 ) ).b;
                    gl_FragColor = vec4( r, g, b, 1.0 );
                }
            `
        };
        const chromaticPass = new THREE.ShaderPass(ChromaticAberrationShader);
        composer.addPass(chromaticPass);

        // Resize handler update
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
            composer.setSize(window.innerWidth, window.innerHeight);
        });

        // --- AUDIO MOCKUP (Visual Feedback) ---
        function playSound(type) {
            // In a real app, we'd use AudioContext. 
            // Here we just rely on visual feedback for "sound".
        }

        // --- PLAYER OBJECT ---
        const player = {
            pos: new THREE.Vector3(0, 5, 0),
            vel: new THREE.Vector3(),
            rot: { yaw: 0, pitch: 0 },
            onGround: false,
            hp: 100,
            maxHp: 100,
            dash: { active: false, timer: 0, cooldown: 0 },
            slide: { active: false },
            camOffset: 0,
            bob: 0,
            weaponIdx: 0,
            recoil: 0
        };
        camera.position.copy(player.pos);

        // --- WEAPONS SYSTEM ---
        const weapons = [
            {
                name: "REVOLVER",
                color: 0x00ffff,
                damage: 40,
                fireRate: 0.35,
                cooldown: 0,
                spread: 0.001,
                count: 1,
                ammo: Infinity,
                maxAmmo: Infinity,
                modelScale: 1
            },
            {
                name: "SHOTGUN",
                color: 0xffaa00,
                damage: 8, // Per pellet
                fireRate: 0.8,
                cooldown: 0,
                spread: 0.15,
                count: 8,
                ammo: 20,
                maxAmmo: 20,
                modelScale: 1.5
            },
            {
                name: "NAILGUN",
                color: 0x00ff00,
                damage: 12,
                fireRate: 0.08,
                cooldown: 0,
                spread: 0.04,
                count: 1,
                ammo: 100,
                maxAmmo: 100,
                modelScale: 1.2
            }
        ];

        // Weapon Model
        const weaponGroup = new THREE.Group();
        const gunGeo = new THREE.BoxGeometry(0.3, 0.3, 1);
        const gunMat = new THREE.MeshStandardMaterial({ color: 0x333333, metalness: 0.8, roughness: 0.2 });
        const gunMesh = new THREE.Mesh(gunGeo, gunMat);
        gunMesh.position.set(0.4, -0.3, -0.6);
        gunMesh.castShadow = true;
        weaponGroup.add(gunMesh);
        camera.add(weaponGroup);
        scene.add(camera);

        // --- PARTICLES SYSTEM ---
        const particles = [];
        const particleGeo = new THREE.BoxGeometry(0.2, 0.2, 0.2);
        
        function spawnParticles(pos, color, count, speed = 1) {
            // Emissive material for Bloom
            const mat = new THREE.MeshBasicMaterial({ color: color }); 
            // To make them glow really bright, we could use StandardMaterial with emissive, 
            // but BasicMaterial with high color values (over 1.0 in float, but here hex) 
            // works with UnrealBloom if the threshold is low enough. 
            // Let's just use bright colors.
            
            for(let i=0; i<count; i++) {
                const mesh = new THREE.Mesh(particleGeo, mat);
                mesh.position.copy(pos).addRandom(0.5);
                const vel = new THREE.Vector3((Math.random()-0.5), (Math.random()), (Math.random()-0.5)).normalize().multiplyScalar(15 * speed);
                scene.add(mesh);
                particles.push({ mesh, vel, life: 0.5 + Math.random() * 0.5, gravity: true });
            }
        }

        function spawnBlood(pos, amount) {
            // Blood heals player if close (Ultrakill mechanic)
            const dist = player.pos.distanceTo(pos);
            if (dist < 8) {
                const heal = amount * 2; // simple calculation
                player.hp = Math.min(player.maxHp, player.hp + heal);
                updateHUD();
            }
            spawnParticles(pos, 0xff0000, amount / 2, 1.5);
        }

        // --- MAP GENERATION ---
        const colliders = [];
        const mapSize = 100;

        function createBlock(x, y, z, w, h, d, color) {
            const geo = new THREE.BoxGeometry(w, h, d);
            // Emissive for style points
            const mat = new THREE.MeshStandardMaterial({ 
                color: color, 
                roughness: 0.2, 
                metalness: 0.5,
                emissive: color,
                emissiveIntensity: 0.1 
            });
            const mesh = new THREE.Mesh(geo, mat);
            mesh.position.set(x, y, z);
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            scene.add(mesh);
            colliders.push({ mesh, box: new THREE.Box3().setFromObject(mesh) });
            return mesh;
        }

        function initMap() {
            // Floor
            createBlock(0, -1, 0, 200, 2, 200, 0x111111);
            
            // Central Arena
            createBlock(0, 0, 0, 20, 1, 20, 0x222222);
            createBlock(0, 3, 0, 5, 6, 5, 0x333333); // Center Pillar

            // Walls
            createBlock(0, 10, -80, 160, 20, 5, 0x551111);
            createBlock(0, 10, 80, 160, 20, 5, 0x551111);
            createBlock(-80, 10, 0, 5, 20, 160, 0x551111);
            createBlock(80, 10, 0, 5, 20, 160, 0x551111);

            // Platforms and Ramps
            // High towers in corners
            createBlock(40, 5, 40, 20, 10, 20, 0x333333);
            createBlock(-40, 5, 40, 20, 10, 20, 0x333333);
            createBlock(40, 5, -40, 20, 10, 20, 0x333333);
            createBlock(-40, 5, -40, 20, 10, 20, 0x333333);

            // Bridges
            createBlock(0, 8, 40, 60, 1, 8, 0x555555);
            createBlock(0, 8, -40, 60, 1, 8, 0x555555);

            // Random cover blocks
            for(let i=0; i<15; i++) {
                const x = (Math.random()-0.5) * 100;
                const z = (Math.random()-0.5) * 100;
                if(Math.abs(x) < 15 && Math.abs(z) < 15) continue; // clear center
                const h = 2 + Math.random() * 4;
                createBlock(x, h/2, z, 4 + Math.random()*4, h, 4 + Math.random()*4, 0x444444);
            }

            // Lights
            const amb = new THREE.AmbientLight(0x404040);
            scene.add(amb);
            const dir = new THREE.DirectionalLight(0xffffff, 0.7);
            dir.position.set(50, 100, 50);
            dir.castShadow = true;
            dir.shadow.mapSize.set(2048, 2048);
            dir.shadow.camera.left = -100;
            dir.shadow.camera.right = 100;
            dir.shadow.camera.top = 100;
            dir.shadow.camera.bottom = -100;
            scene.add(dir);

            // Point lights for atmosphere
            const p1 = new THREE.PointLight(0x00ffff, 1, 40); p1.position.set(0, 10, 0); scene.add(p1);
            const p2 = new THREE.PointLight(0xff0000, 1, 40); p2.position.set(40, 15, 40); scene.add(p2);
            const p3 = new THREE.PointLight(0xff0000, 1, 40); p3.position.set(-40, 15, -40); scene.add(p3);
        }
        initMap();

        // --- ENEMIES ---
        const enemies = [];
        const enemyGeo = {
            grunt: new THREE.BoxGeometry(1, 2, 1),
            drone: new THREE.ConeGeometry(0.8, 1.5, 8),
            tank: new THREE.BoxGeometry(2.5, 3.5, 2.5)
        };
        const enemyMat = {
            grunt: new THREE.MeshStandardMaterial({ color: 0xaa5500 }),
            drone: new THREE.MeshStandardMaterial({ color: 0x00aaff, emissive: 0x002244 }),
            tank: new THREE.MeshStandardMaterial({ color: 0x550000 })
        };

        function spawnEnemy(type, pos) {
            const mesh = new THREE.Mesh(enemyGeo[type], enemyMat[type]);
            mesh.position.copy(pos);
            mesh.castShadow = true;
            if(type === 'drone') mesh.rotation.x = Math.PI / 2; // Point forward
            
            const data = {
                type,
                hp: type==='tank'?300 : (type==='drone'?40:80),
                maxHp: type==='tank'?300 : (type==='drone'?40:80),
                speed: type==='tank'?6 : (type==='drone'?15:10),
                flying: type === 'drone',
                vel: new THREE.Vector3(),
                grounded: false
            };
            mesh.userData = data;
            scene.add(mesh);
            enemies.push(mesh);
        }

        // --- POWERUPS ---
        const powerups = [];
        function spawnPowerup(pos, type) {
            const geo = new THREE.BoxGeometry(0.8, 0.8, 0.8);
            const mat = new THREE.MeshBasicMaterial({ color: type === 'health' ? 0x00ff00 : 0xffff00, wireframe: true });
            const mesh = new THREE.Mesh(geo, mat);
            mesh.position.copy(pos);
            mesh.userData = { type, timer: 0 };
            scene.add(mesh);
            powerups.push(mesh);
        }

        // --- INPUT ---
        window.addEventListener('keydown', e => {
            if(e.code==='KeyW') keys.w=1;
            if(e.code==='KeyA') keys.a=1;
            if(e.code==='KeyS') keys.s=1;
            if(e.code==='KeyD') keys.d=1;
            if(e.code==='Space') keys.space=1;
            if(e.code==='ShiftLeft') keys.shift=1;
            if(e.code==='KeyR') {
                if(state.gameOver || !state.active) resetGame();
            }
            if(e.code==='Digit1') switchWeapon(0);
            if(e.code==='Digit2') switchWeapon(1);
            if(e.code==='Digit3') switchWeapon(2);
        });
        window.addEventListener('keyup', e => {
            if(e.code==='KeyW') keys.w=0;
            if(e.code==='KeyA') keys.a=0;
            if(e.code==='KeyS') keys.s=0;
            if(e.code==='KeyD') keys.d=0;
            if(e.code==='Space') keys.space=0;
            if(e.code==='ShiftLeft') keys.shift=0;
        });
        window.addEventListener('mousedown', () => {
            if(!state.active && !state.gameOver) {
                document.body.requestPointerLock();
                state.active = true;
                document.getElementById('instructions').style.display = 'none';
                document.getElementById('hud').classList.remove('hidden');
            } else if(state.active && !state.gameOver) {
                shoot();
            }
        });
        window.addEventListener('mousemove', e => {
            if(state.active) {
                player.rot.yaw -= e.movementX * CONFIG.lookSens;
                player.rot.pitch -= e.movementY * CONFIG.lookSens;
                player.rot.pitch = Math.max(-1.5, Math.min(1.5, player.rot.pitch));
            }
        });

        function switchWeapon(idx) {
            player.weaponIdx = idx;
            const w = weapons[idx];
            // Update HUD visual
            document.getElementById('weaponName').innerText = w.name;
            document.getElementById('weaponName').style.color = '#' + w.color.toString(16).padStart(6, '0');
            document.getElementById('wep1').style.backgroundColor = idx===0?'#0ff':'#444';
            document.getElementById('wep2').style.backgroundColor = idx===1?'#0ff':'#444';
            document.getElementById('wep3').style.backgroundColor = idx===2?'#0ff':'#444';
            
            // Change model visual slightly
            gunMesh.scale.set(1, 1, w.modelScale);
            gunMesh.material.color.setHex(w.color);
            updateHUD();
        }

        function shoot() {
            const w = weapons[player.weaponIdx];
            if(w.cooldown > 0 || w.ammo <= 0) return;
            
            if(w.ammo !== Infinity) w.ammo--;
            w.cooldown = w.fireRate;
            
            // Recoil
            player.rot.pitch += 0.02 * w.modelScale;
            gunMesh.position.z += 0.2; // Kickback

            // Raycast
            const raycaster = new THREE.Raycaster();
            const center = new THREE.Vector2(0,0);
            
            for(let i=0; i<w.count; i++) {
                // Spread
                const spreadX = (Math.random()-0.5) * w.spread;
                const spreadY = (Math.random()-0.5) * w.spread;
                raycaster.setFromCamera(new THREE.Vector2(spreadX, spreadY), camera);
                
                const intersects = raycaster.intersectObjects(scene.children);
                let hit = null;
                
                // Filter out player/projectiles
                for(let obj of intersects) {
                    if(obj.object !== gunMesh && !obj.object.userData.isPowerup) {
                        hit = obj;
                        break;
                    }
                }

                if(hit) {
                    // Create trail
                    const trailGeo = new THREE.BufferGeometry().setFromPoints([
                        new THREE.Vector3(0.5, -0.5, -1).applyMatrix4(camera.matrixWorld),
                        hit.point
                    ]);
                    const trailMat = new THREE.LineBasicMaterial({ color: w.color, transparent: true, opacity: 0.5 });
                    const trail = new THREE.Line(trailGeo, trailMat);
                    scene.add(trail);
                    setTimeout(()=>scene.remove(trail), 50);

                    // Hit logic
                    if(hit.object.userData.hp) {
                        const dmg = w.damage;
                        hit.object.userData.hp -= dmg;
                        hit.object.material.emissive = new THREE.Color(0xffffff);
                        setTimeout(()=>hit.object.material.emissive = new THREE.Color(hit.object.userData.flying?0x002244:0x000000), 50);
                        
                        // Show hitmarker
                        const hm = document.getElementById('hitmarker');
                        hm.style.opacity = 1;
                        setTimeout(()=>hm.style.opacity=0, 100);

                        spawnParticles(hit.point, 0xff0000, 3, 0.5);

                        // Knockback
                        const push = hit.point.clone().sub(player.pos).normalize().multiplyScalar(2);
                        hit.object.userData.vel.add(push);

                        if(hit.object.userData.hp <= 0) {
                            killEnemy(hit.object);
                        }
                    } else {
                        spawnParticles(hit.point, 0xffff00, 2, 0.3);
                    }
                }
            }
            updateHUD();
        }

        function killEnemy(mesh) {
            spawnBlood(mesh.position, 20);
            state.score += mesh.userData.maxHp;
            
            // Chance to drop ammo
            if(Math.random() > 0.7) {
                spawnPowerup(mesh.position, 'ammo');
            }
            
            scene.remove(mesh);
            const idx = enemies.indexOf(mesh);
            if(idx > -1) enemies.splice(idx, 1);
            
            const scoreText = document.getElementById('scoreVal');
            scoreText.innerText = state.score;
            scoreText.style.transform = "scale(1.2)";
            setTimeout(()=>scoreText.style.transform="scale(1)", 100);
        }

        function resetGame() {
            player.hp = player.maxHp;
            player.pos.set(0, 5, 0);
            player.vel.set(0, 0, 0);
            state.score = 0;
            state.active = false;
            state.gameOver = false;
            
            weapons[1].ammo = weapons[1].maxAmmo;
            weapons[2].ammo = weapons[2].maxAmmo;
            
            enemies.forEach(e => scene.remove(e));
            enemies.length = 0;
            powerups.forEach(p => scene.remove(p));
            powerups.length = 0;
            
            document.getElementById('deathScreen').classList.add('hidden');
            document.getElementById('hud').classList.add('hidden');
            document.getElementById('instructions').style.display = 'flex';
            document.exitPointerLock();
            updateHUD();
        }

        function updateHUD() {
            const hpBar = document.getElementById('hpBar');
            const pct = Math.max(0, player.hp / player.maxHp);
            hpBar.style.width = (pct * 100) + "%";
            document.getElementById('hpVal').innerText = Math.ceil(player.hp);
            
            const w = weapons[player.weaponIdx];
            document.getElementById('ammoVal').innerText = w.ammo === Infinity ? "∞" : w.ammo;
            
            // Dynamic Crosshair
            const circle = document.getElementById('crosshairCircle');
            const spread = 20 + (player.vel.length() * 2) + (w.spread * 200);
            circle.style.width = spread + "px";
            circle.style.height = spread + "px";
        }

        function checkCollision(pos) {
            const box = new THREE.Box3().setFromCenterAndSize(pos, new THREE.Vector3(1, 1.8, 1));
            for(let c of colliders) {
                if(box.intersectsBox(c.box)) return true;
            }
            return false;
        }

        // --- MAIN LOOP ---
        let spawnTimer = 0;

        function update(time) {
            requestAnimationFrame(update);
            const dt = Math.min((time - state.lastTime)/1000, 0.1);
            state.lastTime = time;

            if(!state.active || state.gameOver) return;

            // --- PLAYER MOVEMENT ---
            // Input vector
            const fwd = new THREE.Vector3(-Math.sin(player.rot.yaw), 0, -Math.cos(player.rot.yaw));
            const right = new THREE.Vector3(Math.cos(player.rot.yaw), 0, -Math.sin(player.rot.yaw));
            const inputDir = new THREE.Vector3();
            if(keys.w) inputDir.add(fwd);
            if(keys.s) inputDir.sub(fwd);
            if(keys.d) inputDir.add(right);
            if(keys.a) inputDir.sub(right);
            if(inputDir.lengthSq() > 0) inputDir.normalize();

            // SLIDE LOGIC
            let isSliding = false;
            if(keys.shift && player.onGround) {
                isSliding = true;
                player.camOffset = THREE.MathUtils.lerp(player.camOffset, -1.0, dt * 10);
                // Boost if initiating slide and moving forward
                if(!player.slide.active && inputDir.lengthSq() > 0) {
                    const boost = inputDir.clone().multiplyScalar(15);
                    player.vel.add(boost);
                }
                player.slide.active = true;
            } else {
                isSliding = false;
                player.slide.active = false;
                player.camOffset = THREE.MathUtils.lerp(player.camOffset, 0, dt * 5);
            }

            // ACCELERATION & FRICTION
            if (isSliding) {
                // Sliding: Low friction, no input acceleration (momentum based)
                const fric = CONFIG.slideFriction;
                player.vel.x -= player.vel.x * fric * dt;
                player.vel.z -= player.vel.z * fric * dt;
                // Allow slight steering
                player.vel.addScaledVector(inputDir, CONFIG.airAccel * 0.5 * dt);
            } else {
                // Running/Air
                const accel = player.onGround ? CONFIG.groundAccel : CONFIG.airAccel;
                const fric = player.onGround ? CONFIG.friction : 0; 
                
                // Apply Speed Limit smoothly for acceleration
                const currentSpeed = new THREE.Vector2(player.vel.x, player.vel.z).length();
                if(currentSpeed < CONFIG.speed || !player.onGround) {
                     player.vel.addScaledVector(inputDir, accel * dt);
                }
                
                // Friction
                if(player.onGround) {
                    const damping = Math.min(1.0, fric * dt);
                    player.vel.x *= (1 - damping);
                    player.vel.z *= (1 - damping);
                } else {
                    // Air drag (very minimal)
                    player.vel.x *= (1 - 0.1 * dt);
                    player.vel.z *= (1 - 0.1 * dt);
                }
            }

            // Gravity
            player.vel.y += CONFIG.gravity * dt;

            // Jump
            if(keys.space && player.onGround) {
                player.vel.y = CONFIG.jumpForce;
                player.onGround = false;
            }

            // SEPARATE AXIS COLLISION (SLIDING)
            // X Axis
            let nextPos = player.pos.clone();
            nextPos.x += player.vel.x * dt;
            if(checkCollision(nextPos)) {
                player.vel.x = 0; // Stop X
            } else {
                player.pos.x = nextPos.x;
            }

            // Z Axis
            nextPos = player.pos.clone();
            nextPos.z += player.vel.z * dt;
            if(checkCollision(nextPos)) {
                player.vel.z = 0; // Stop Z
            } else {
                player.pos.z = nextPos.z;
            }

            // Y Axis (Ground/Ceiling)
            nextPos = player.pos.clone();
            nextPos.y += player.vel.y * dt;
            // Check feet (ground)
            let grounded = false;
            if(nextPos.y < 1) { // Simple floor check
                nextPos.y = 1;
                player.vel.y = 0;
                grounded = true;
            } else {
                // Check platforms
                // Simple AABB check for feet
                const feetBox = new THREE.Box3().setFromCenterAndSize(new THREE.Vector3(nextPos.x, nextPos.y - 0.9, nextPos.z), new THREE.Vector3(0.8, 0.2, 0.8));
                for(let c of colliders) {
                    if(feetBox.intersectsBox(c.box)) {
                        // Only land if falling and above
                        if(player.vel.y <= 0 && player.pos.y > c.box.max.y) {
                            nextPos.y = c.box.max.y + 1; // Player height/2 + offset
                            player.vel.y = 0;
                            grounded = true;
                        }
                        // Ceiling check could go here
                    }
                }
            }
            player.pos.y = nextPos.y;
            player.onGround = grounded;

            // Camera & Weapon Sync
            camera.position.copy(player.pos);
            camera.position.y += 0.6 + player.camOffset; // Eye level
            camera.rotation.order = 'YXZ';
            camera.rotation.y = player.rot.yaw;
            camera.rotation.x = player.rot.pitch;
            
            // Camera Tilt (Strafing)
            // Calculate local velocity x
            const localVel = player.vel.clone().applyAxisAngle(new THREE.Vector3(0,1,0), -player.rot.yaw);
            const targetTilt = -localVel.x * 0.002; // Tilt based on sideways speed
            camera.rotation.z = THREE.MathUtils.lerp(camera.rotation.z, targetTilt, dt * 10);

            // Dynamic FOV - Enhanced
            const speedVal = new THREE.Vector2(player.vel.x, player.vel.z).length();
            const targetFov = 90 + (speedVal * 0.8); // Stronger FOV effect
            camera.fov = THREE.MathUtils.lerp(camera.fov, Math.min(140, targetFov), dt * 5);
            camera.updateProjectionMatrix();
            
            // Chromatic Aberration based on speed
            chromaticPass.uniforms.amount.value = 0.002 + (speedVal * 0.0001);

            // Weapon Sway
            gunMesh.position.set(0.4, -0.3 + player.camOffset * 0.3, -0.6);
            gunMesh.position.x -= player.vel.x * 0.002;
            gunMesh.position.y -= player.vel.y * 0.002;
            // Recoil Recover
            gunMesh.position.z = THREE.MathUtils.lerp(gunMesh.position.z, -0.6, dt*10);

            // --- ENEMY SPAWNER ---
            spawnTimer -= dt;
            if(spawnTimer <= 0) {
                // Difficulty Scaling
                const maxEnemies = 5 + Math.floor(state.score / 500);
                if(enemies.length < maxEnemies) {
                    const r = Math.random();
                    let type = 'grunt';
                    if(r > 0.6) type = 'drone';
                    if(r > 0.9) type = 'tank';
                    
                    // Find spawn point
                    const angle = Math.random() * Math.PI * 2;
                    const dist = 30 + Math.random() * 40;
                    const ex = player.pos.x + Math.cos(angle) * dist;
                    const ez = player.pos.z + Math.sin(angle) * dist;
                    spawnEnemy(type, new THREE.Vector3(ex, type==='drone'?10:2, ez));
                }
                spawnTimer = 3.0 - Math.min(2, state.score/2000);
            }

            // --- ENEMY LOGIC ---
            enemies.forEach(mesh => {
                const data = mesh.userData;
                const dist = mesh.position.distanceTo(player.pos);
                
                // Move towards player
                const dir = player.pos.clone().sub(mesh.position);
                
                if(data.flying) {
                    // Drone Logic: Fly straight
                    dir.normalize();
                    mesh.position.addScaledVector(dir, data.speed * dt);
                    mesh.lookAt(player.pos);
                } else {
                    // Ground Logic:
                    dir.y = 0;
                    dir.normalize();
                    
                    // Basic Jump Logic
                    // Cast ray forward to detect wall
                    const ray = new THREE.Raycaster(mesh.position, dir, 0, 2);
                    const hits = ray.intersectObjects(scene.children);
                    let wallAhead = false;
                    for(let h of hits) {
                        if(!h.object.userData.type && h.object !== mesh) wallAhead = true;
                    }

                    if(wallAhead && data.grounded) {
                        data.vel.y = 15; // Jump
                        data.grounded = false;
                    }

                    data.vel.y += CONFIG.gravity * dt;
                    
                    // Move XZ
                    mesh.position.x += dir.x * data.speed * dt;
                    mesh.position.z += dir.z * data.speed * dt;
                    mesh.position.y += data.vel.y * dt;

                    // Ground Collision
                    let eGrounded = false;
                    if(mesh.position.y < 1 + (data.type==='tank'?1:0)) {
                        mesh.position.y = 1 + (data.type==='tank'?1:0);
                        data.vel.y = 0;
                        eGrounded = true;
                    } else {
                         // Simple platform check for enemies (simplified)
                         if(data.vel.y <= 0) {
                             for(let c of colliders) {
                                 if(Math.abs(mesh.position.x - c.mesh.position.x) < c.mesh.geometry.parameters.width/2 &&
                                    Math.abs(mesh.position.z - c.mesh.position.z) < c.mesh.geometry.parameters.depth/2 &&
                                    Math.abs(mesh.position.y - (c.mesh.position.y + c.mesh.geometry.parameters.height/2 + 1)) < 0.5) {
                                     mesh.position.y = c.mesh.position.y + c.mesh.geometry.parameters.height/2 + 1;
                                     data.vel.y = 0;
                                     eGrounded = true;
                                 }
                             }
                         }
                    }
                    data.grounded = eGrounded;
                    
                    // Look at player
                    mesh.lookAt(player.pos.x, mesh.position.y, player.pos.z);
                }

                // Damage Player
                if(dist < 2.5) {
                    player.hp -= (data.type==='tank'?30:10) * dt;
                    document.getElementById('damageOverlay').style.boxShadow = "inset 0 0 50px rgba(255,0,0,0.5)";
                    setTimeout(() => document.getElementById('damageOverlay').style.boxShadow = "none", 100);
                    
                    if(player.hp <= 0) {
                        player.hp = 0;
                        state.gameOver = true;
                        document.getElementById('finalScore').innerText = state.score;
                        document.getElementById('deathScreen').classList.remove('hidden');
                        document.exitPointerLock();
                    }
                    updateHUD();
                }
            });

            // --- POWERUPS LOGIC ---
            for(let i=powerups.length-1; i>=0; i--) {
                const p = powerups[i];
                p.rotation.y += dt * 2;
                p.position.y = 1 + Math.sin(time/500 + i)*0.5;
                
                if(p.position.distanceTo(player.pos) < 2) {
                    if(p.userData.type === 'ammo') {
                        weapons[1].ammo = Math.min(weapons[1].ammo + 10, weapons[1].maxAmmo);
                        weapons[2].ammo = Math.min(weapons[2].ammo + 40, weapons[2].maxAmmo);
                        updateHUD();
                    }
                    scene.remove(p);
                    powerups.splice(i, 1);
                }
            }

            // --- WEAPON COOLDOWNS ---
            weapons.forEach(w => {
                if(w.cooldown > 0) w.cooldown -= dt;
            });

            // --- PARTICLE UPDATE ---
            for(let i=particles.length-1; i>=0; i--) {
                const p = particles[i];
                p.life -= dt;
                p.mesh.position.addScaledVector(p.vel, dt);
                if(p.gravity) p.vel.y += CONFIG.gravity * dt;
                p.mesh.rotation.x += dt;
                
                if(p.mesh.position.y < 0) { // Bounce
                    p.mesh.position.y = 0;
                    p.vel.y *= -0.6;
                    p.vel.x *= 0.8;
                    p.vel.z *= 0.8;
                }

                if(p.life <= 0) {
                    scene.remove(p.mesh);
                    particles.splice(i, 1);
                }
            }

            // Replace standard render with composer render
            composer.render();
        }

        requestAnimationFrame(update);

        // Add helper method for Random in Vector
        THREE.Vector3.prototype.addRandom = function(s) {
            this.x += (Math.random()-0.5)*s;
            this.y += (Math.random()-0.5)*s;
            this.z += (Math.random()-0.5)*s;
            return this;
        };
    </script>
